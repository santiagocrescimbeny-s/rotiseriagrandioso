}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model address {
  address_id            BigInt   @id @default(autoincrement())
  user_id               BigInt
  title                 String?  @db.VarChar(50)
  street_address        String   @db.VarChar(150)
  number                String?  @db.VarChar(20)
  apartment_floor       String?  @db.VarChar(20)
  city                  String   @db.VarChar(100)
  state_province        String?  @db.VarChar(100)
  postal_code           String?  @db.VarChar(20)
  latitude              Decimal? @db.Decimal(10, 8)
  longitude             Decimal? @db.Decimal(11, 8)
  delivery_instructions String?
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)
  users                 users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_addresses_users")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model companies {
  company_id      BigInt            @id @default(autoincrement())
  name            String            @db.VarChar(150)
  legal_name      String?           @db.VarChar(150)
  cuit_tax_id     String?           @db.VarChar(30)
  phone           String?           @db.VarChar(30)
  whatsapp        String?           @db.VarChar(30)
  email           String?           @db.VarChar(255)
  address         String?           @db.VarChar(200)
  city            String?           @db.VarChar(100)
  state_province  String?           @db.VarChar(100)
  postal_code     String?           @db.VarChar(20)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  company_images  company_images[]
  job_position    job_position[]
  operating_hours operating_hours[]
  order_payment   order_payment[]
  purchase        purchase[]
